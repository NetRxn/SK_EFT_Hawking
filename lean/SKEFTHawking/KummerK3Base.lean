import Mathlib

namespace SKEFTHawking.KummerK3Base

open scoped Manifold ContDiff

/-- The **flat 4-torus** `T⁴`, realized as the 4-fold product of the standard smooth circle
`Circle = {z : ℂ | ‖z‖ = 1}` (the unit circle in ℂ, Mathlib's smooth 1-manifold / Lie group), i.e.
`T⁴ = (S¹)⁴`. This is the Kummer construction's base (K0): the flat torus `(ℝ/ℤ)⁴` is diffeomorphic to
`(S¹)⁴`, and the product-of-circles model gives its smooth structure for free from Mathlib. The
substantive content of this brick is precisely this modeling choice; the facts below then follow from
the binary-product manifold/topology instances. -/
abbrev TorusFour : Type := Circle × Circle × Circle × Circle

/-- The **product model-with-corners** for `T⁴`: four copies of the circle's model `𝓡 1` (on
`EuclideanSpace ℝ (Fin 1)`), so `T⁴` is modeled on `𝔼¹ × 𝔼¹ × 𝔼¹ × 𝔼¹` (real dimension 4). -/
noncomputable def torusFourModel :
    ModelWithCorners ℝ (EuclideanSpace ℝ (Fin 1) × EuclideanSpace ℝ (Fin 1) ×
        EuclideanSpace ℝ (Fin 1) × EuclideanSpace ℝ (Fin 1))
      (ModelProd (EuclideanSpace ℝ (Fin 1)) (ModelProd (EuclideanSpace ℝ (Fin 1))
        (ModelProd (EuclideanSpace ℝ (Fin 1)) (EuclideanSpace ℝ (Fin 1))))) :=
  (𝓡 1).prod ((𝓡 1).prod ((𝓡 1).prod (𝓡 1)))

/-- `T⁴` is **nonempty** — a genuine (non-degenerate) manifold. Witnessed by the group identity
`(1,1,1,1)` (each circle factor contains `1 = exp(0)`). -/
theorem torusFour_nonempty : Nonempty TorusFour := ⟨(1, 1, 1, 1)⟩

/-- `T⁴` is **Hausdorff** (`T2Space`) — inherited from the circle's metric topology through the
product. -/
theorem torusFour_t2Space : T2Space TorusFour := inferInstance

/-- `T⁴` is **compact** — the closed half of "closed 4-manifold" (each `S¹` is compact, product of
finitely many compacts is compact). -/
theorem torusFour_compactSpace : CompactSpace TorusFour := inferInstance

/-- `T⁴` is a **charted space** modeled on `𝔼¹ × 𝔼¹ × 𝔼¹ × 𝔼¹` — it has an atlas of charts into
Euclidean space (the binary-product `ChartedSpace` instance, iterated). `ChartedSpace` is data, so this
is a `def` exhibiting the concrete atlas witness. -/
@[reducible] noncomputable def torusFourChartedSpace :
    ChartedSpace (ModelProd (EuclideanSpace ℝ (Fin 1))
      (ModelProd (EuclideanSpace ℝ (Fin 1))
        (ModelProd (EuclideanSpace ℝ (Fin 1)) (EuclideanSpace ℝ (Fin 1))))) TorusFour :=
  inferInstance

/-- `T⁴` is a **smooth (`C^ω`) manifold** on the product model `torusFourModel` — the analytic
smoothness of the circle transfers through the binary-product `IsManifold` instance. Together with
`torusFour_compactSpace` and `torusFourModel_boundaryless` this is "smooth closed 4-manifold". -/
theorem torusFour_isManifold :
    IsManifold ((𝓡 1).prod ((𝓡 1).prod ((𝓡 1).prod (𝓡 1)))) ω TorusFour := inferInstance

/-- `T⁴` is a **Lie group** (`(S¹)⁴`, the compact abelian Lie group `𝕋⁴`) — the group multiplication
and inversion are smooth for `torusFourModel`, from the circle's Lie-group structure through the
binary-product `Prod.instLieGroup`. This is the seed of the K9 spin brick: a Lie group is
parallelizable (its tangent bundle is trivialized by left-invariant frames), hence has `w₂ = 0`, hence
is spin — so `T⁴`, and after resolution the Kummer K3, carry the spin tangential structure the
generator needs. (The parallelizable ⟹ spin chain is not yet in Mathlib; this fact is its foothold.) -/
theorem torusFour_lieGroup :
    LieGroup ((𝓡 1).prod ((𝓡 1).prod ((𝓡 1).prod (𝓡 1)))) ω TorusFour := inferInstance

/-- The product model is **boundaryless** — the no-boundary half of "closed 4-manifold" (`𝓡 1` is
boundaryless; products of boundaryless models are boundaryless). -/
theorem torusFourModel_boundaryless :
    ((𝓡 1).prod ((𝓡 1).prod ((𝓡 1).prod (𝓡 1))) :
      ModelWithCorners ℝ _ _).Boundaryless := inferInstance

/-- **`T⁴` is 4-dimensional**: its model vector space `𝔼¹ × 𝔼¹ × 𝔼¹ × 𝔼¹` has real dimension 4
(`1+1+1+1`). The falsifiable numeric pin that makes `TorusFour` a *4*-manifold. -/
theorem torusFour_model_finrank :
    Module.finrank ℝ (EuclideanSpace ℝ (Fin 1) × EuclideanSpace ℝ (Fin 1) ×
      EuclideanSpace ℝ (Fin 1) × EuclideanSpace ℝ (Fin 1)) = 4 := by
  simp [Module.finrank_prod]

end SKEFTHawking.KummerK3Base
