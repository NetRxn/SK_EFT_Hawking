/-
# Phase 5q.H — the TWO-THRESHOLD chart-1 excision of input (C1)

With (C0) discharged (`KummerSplitBCoreVanishInt.relHomologyInt_splitBOpen_eq_zero`), the whole
`H₂(K3;ℤ) ≅ ℤ²²` headline rests on one statement:

> **(C1)** `H₂(splitBOpen r, outerE; ℤ)` is generated by one element.

This module excises it onto **one chart**. The obvious move — excise `splitBOpen r` down to its
chart-1 piece `chartNbhd1 r` — **fails**, and the failure is instructive:

> the excision hypothesis needs `splitBOpen r ∖ chartNbhd1 r ⊆ interior_{splitBOpen r} (outerE)`,
> and `splitBOpen r ∖ chartNbhd1 r = outerE ∩ deepChart0 r`. A point with `‖base‖ = r` **exactly**
> and `fiberNorm = 1/2` **exactly** is a *corner*: arbitrarily near it are points with `‖base‖ > r`
> and `fiberNorm < 1/2`, which lie in `splitBOpen r` (via `chartNbhd1 r`) but not in `outerE`. So it
> is not interior, and a **single-threshold** excision does not apply.

The fix is **two thresholds** `r' < r`: keep the *larger* chart-1 neighbourhood `chartNbhd1 r'` as
the retained piece. Then

> `splitBOpen r ∖ chartNbhd1 r' = outerE ∩ deepChart0 r'`,

and every point of that set has base norm `≤ r' < r`, so the **open** set
`openBaseE r = chart0 '' {‖z‖ < r}` is a neighbourhood of it inside `splitBOpen r` that is entirely
contained in `outerE` (`openBaseE_inter_splitBOpen_subset`: a chart-0 point with `‖z‖ < r` is deep in
chart 0, hence misses `chartNbhd1 r`, hence — being in `splitBOpen r` — lies in `outerE`). The
corner is gone: the two thresholds separate "deep enough to be forced into `outerE`" from "deep
enough to be discarded".

The output (`outerECyclic_of_chart1_local`, `kummerK3_b2_target_of_chart1_local`) puts the ℤ²²
headline on a **single chart-1-local cyclicity hypothesis**, with no ambient statement and no
extension problem left in it.

Kernel-pure (`{propext, Classical.choice, Quot.sound}`); no `sorry`, no new axiom, no
`native_decide`, no `maxHeartbeats`.
-/
import Mathlib
import SKEFTHawking.KummerSplitBCoreVanishInt

open SKEFTHawking.SingularRelHomologyInt (RelHomologyInt)
open SKEFTHawking.SingularRelativeHomologyMod2 (sub)
open SKEFTHawking.SingularExcisionIso (restr)
open SKEFTHawking.SingularExcisionIsoInt (excisionEquivInt)
open SKEFTHawking.SingularRelativeTripleSurjInt (cyclic_of_surjective)
open SKEFTHawking.KummerResolutionPiece (ResE ResChart chart0 chart1 chart0_inj_iff
  chart0_eq_chart1_iff resSetoid)
open SKEFTHawking.KummerPairTransportInt (ResEtop)
open SKEFTHawking.KummerPieceCollarInt (outerE)
open SKEFTHawking.KummerPieceCollarCyclicInt (OuterECyclic)
open SKEFTHawking.KummerChartNbhdInt (deepChart0 chartNbhd1 splitBOpen isOpen_chartNbhd1)
open SKEFTHawking.KummerSplitBCoreVanishInt (outerECyclic_of_cyclic kummerK3_b2_target_of_cyclic)

namespace SKEFTHawking.KummerSplitBChart1ExcisionInt

noncomputable section

/-! ## §1. The open deep-base region of chart 0 -/

/-- The chart-0 points with base norm **strictly** below `s`. For `s ≤ 1` this misses every weld
(a weld forces base norm `1`), so its image in `E` is open. -/
def openBaseSet (s : ℝ) : Set ResChart := {p | ‖(p.1 : ℂ)‖ < s}

/-- Its image in `E`. -/
def openBaseE (s : ℝ) : Set ↑ResEtop := chart0 '' openBaseSet s

theorem chart1_notMem_openBaseE {s : ℝ} (hs : s ≤ 1) (q : ResChart) : chart1 q ∉ openBaseE s := by
  rintro ⟨p, hp, hmk⟩
  obtain ⟨hseam, -, -⟩ := chart0_eq_chart1_iff.mp hmk
  have : ‖(p.1 : ℂ)‖ < 1 := lt_of_lt_of_le hp hs
  rw [hseam] at this
  exact lt_irrefl 1 this

theorem isOpen_openBaseE {s : ℝ} (hs : s ≤ 1) : IsOpen (openBaseE s) := by
  refine (isQuotientMap_quotient_mk' (s := resSetoid)).isOpen_preimage.mp ?_
  rw [isOpen_sum_iff]
  constructor
  · show IsOpen {p : ResChart | chart0 p ∈ openBaseE s}
    have h : {p : ResChart | chart0 p ∈ openBaseE s} = openBaseSet s := by
      ext p
      constructor
      · rintro ⟨q, hq, hmk⟩
        rwa [chart0_inj_iff.mp hmk] at hq
      · intro hp; exact ⟨p, hp, rfl⟩
    rw [h]
    exact isOpen_lt (continuous_norm.comp (continuous_subtype_val.comp continuous_fst))
      continuous_const
  · show IsOpen {p : ResChart | chart1 p ∈ openBaseE s}
    have h : {p : ResChart | chart1 p ∈ openBaseE s} = (∅ : Set ResChart) := by
      ext p
      exact ⟨fun hp => (chart1_notMem_openBaseE hs p hp).elim, fun hp => hp.elim⟩
    rw [h]
    exact isOpen_empty

/-- **The forcing step.** A point of `splitBOpen r` whose base norm is `< r` is *deep* in chart `0`,
so it cannot be supplied by `chartNbhd1 r = (deepChart0 r)ᶜ` — it must be supplied by `outerE`. This
is what makes `openBaseE r` an `outerE`-neighbourhood inside `splitBOpen r`. -/
theorem openBaseE_inter_splitBOpen_subset (r : ℝ) :
    openBaseE r ∩ splitBOpen r ⊆ outerE := by
  rintro y ⟨⟨p, hp, rfl⟩, hB⟩
  rcases hB with hout | hnb
  · exact hout
  · have hlt : ‖(p.1 : ℂ)‖ < r := hp
    have hmem : p ∈ SKEFTHawking.KummerChartNbhdInt.deepChartSet r := by
      show ‖(p.1 : ℂ)‖ ≤ r
      exact le_of_lt hlt
    exact absurd ⟨p, hmem, rfl⟩ hnb

/-! ## §2. The two-threshold excision cover -/

/-- The relative subspace of the pair `(splitBOpen r, outerE)`, read intrinsically. -/
abbrev outerSub (r : ℝ) : Set ↑(sub (splitBOpen r)) := restr outerE (splitBOpen r)

/-- The retained chart-1 piece, at the **second** threshold `r' < r`. -/
abbrev chart1Sub (r r' : ℝ) : Set ↑(sub (splitBOpen r)) := restr (chartNbhd1 r') (splitBOpen r)

/-- **The two-threshold excision cover.** Inside `splitBOpen r`, the interiors of `outerE` and of
`chartNbhd1 r'` cover, provided `r' < r ≤ 1`.

This is exactly what the **single-threshold** choice `r' = r` fails to give: with `r' = r` the
uncovered set is `outerE ∩ deepChart0 r`, whose `‖base‖ = r` corner is not interior to `outerE`
inside `splitBOpen r` (points just outside the base disk with fiber norm below `1/2` belong to
`splitBOpen r` but not to `outerE`). Taking `r' < r` moves the uncovered set strictly inside the
base disk of radius `r`, where the open neighbourhood `openBaseE r` is available. -/
theorem splitBOpen_chart1_cover {r r' : ℝ} (hr : r ≤ 1) (hr'1 : r' < 1) (hr' : r' < r) :
    (⋃ U ∈ ({outerSub r, chart1Sub r r'} : Set (Set ↑(sub (splitBOpen r)))), interior U)
      = Set.univ := by
  refine Set.eq_univ_of_forall fun y => ?_
  by_cases hy : (y : ↑ResEtop) ∈ chartNbhd1 r'
  · refine Set.mem_biUnion (Set.mem_insert_of_mem _ rfl) ?_
    rw [((isOpen_chartNbhd1 hr'1).preimage continuous_subtype_val).interior_eq]
    exact hy
  · refine Set.mem_biUnion (Set.mem_insert _ _) ?_
    -- `y` is deep in chart 0 at the *second* threshold, hence strictly inside the *first*
    obtain ⟨p, hp, hpy⟩ : (y : ↑ResEtop) ∈ deepChart0 r' := by
      by_contra hcon
      exact hy hcon
    have hyW : y ∈ Subtype.val ⁻¹' openBaseE r :=
      ⟨p, lt_of_le_of_lt hp hr', hpy⟩
    refine interior_maximal ?_ ((isOpen_openBaseE hr).preimage continuous_subtype_val) hyW
    intro w hw
    exact openBaseE_inter_splitBOpen_subset r ⟨hw, w.2⟩

/-- **The chart-1 excision isomorphism.**
`H₂(chartNbhd1 r', outerE ∩ chartNbhd1 r'; ℤ) ≅ H₂(splitBOpen r, outerE; ℤ)` — the deep chart-0
part of the collar is excised. -/
def chart1ExcisionEquiv {r r' : ℝ} (hr : r ≤ 1) (hr'1 : r' < 1) (hr' : r' < r) :
    RelHomologyInt (restr (outerSub r) (chart1Sub r r')) 2
      ≃ₗ[ℤ] RelHomologyInt (outerSub r) 2 :=
  excisionEquivInt (outerSub r) (chart1Sub r r') 1 (splitBOpen_chart1_cover hr hr'1 hr')

/-! ## §3. The headline on ONE chart-1-local input -/

/-- **Input (C1), excised onto chart 1.** Cyclicity of the chart-1 pair group transports to
cyclicity of `H₂(splitBOpen r, outerE; ℤ)`. -/
theorem outerSub_cyclic_of_chart1_local {r r' : ℝ} (hr : r ≤ 1) (hr'1 : r' < 1) (hr' : r' < r)
    (hcyc : ∃ a : RelHomologyInt (restr (outerSub r) (chart1Sub r r')) 2,
      ∀ x : RelHomologyInt (restr (outerSub r) (chart1Sub r r')) 2, ∃ k : ℤ, x = k • a) :
    ∃ g : RelHomologyInt (outerSub r) 2,
      ∀ y : RelHomologyInt (outerSub r) 2, ∃ k : ℤ, y = k • g := by
  obtain ⟨a, hgen⟩ := hcyc
  refine ⟨chart1ExcisionEquiv hr hr'1 hr' a, ?_⟩
  exact cyclic_of_surjective (chart1ExcisionEquiv hr hr'1 hr').toLinearMap
    (chart1ExcisionEquiv hr hr'1 hr').surjective hgen

/-- **The `b₂` residual from one chart-1-local input.** -/
theorem outerECyclic_of_chart1_local {r r' : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (hr'1 : r' < 1)
    (hr' : r' < r)
    (hcyc : ∃ a : RelHomologyInt (restr (outerSub r) (chart1Sub r r')) 2,
      ∀ x : RelHomologyInt (restr (outerSub r) (chart1Sub r r')) 2, ∃ k : ℤ, x = k • a) :
    OuterECyclic :=
  outerECyclic_of_cyclic hr0 hr1
    (outerSub_cyclic_of_chart1_local (le_of_lt hr1) hr'1 hr' hcyc)

/-- **The headline, on ONE chart-1-local input.** `H₂(K3;ℤ) ≅ ℤ²²` follows from cyclicity of the
chart-1 pair group `H₂(chartNbhd1 r', outerE ∩ chartNbhd1 r'; ℤ)` alone. Everything else — the
ambient vanishing (C0), the excision, the extension algebra, the sixteen-fold weld bookkeeping — is
now proved. -/
theorem kummerK3_b2_target_of_chart1_local {r r' : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (hr'1 : r' < 1)
    (hr' : r' < r)
    (hcyc : ∃ a : RelHomologyInt (restr (outerSub r) (chart1Sub r r')) 2,
      ∀ x : RelHomologyInt (restr (outerSub r) (chart1Sub r r')) 2, ∃ k : ℤ, x = k • a) :
    SKEFTHawking.KummerK7Opener.kummerK3_b2_target :=
  kummerK3_b2_target_of_cyclic hr0 hr1
    (outerSub_cyclic_of_chart1_local (le_of_lt hr1) hr'1 hr' hcyc)

/-! ## §4. Flattening the nested subspaces -/

/-- **A subspace of a subspace is the intersection**: `sub (restr A B) ≃ₜ sub (A ∩ B)`. -/
def subRestrHomeo {X : TopCat} (A B : Set ↑X) : ↥(restr A B) ≃ₜ ↥(A ∩ B) where
  toFun x := ⟨((x : ↥B) : ↑X), x.2, (x : ↥B).2⟩
  invFun y := ⟨⟨(y : ↑X), y.2.2⟩, y.2.1⟩
  left_inv _ := rfl
  right_inv _ := rfl
  continuous_toFun :=
    Continuous.subtype_mk (continuous_subtype_val.comp continuous_subtype_val) _
  continuous_invFun :=
    Continuous.subtype_mk (Continuous.subtype_mk continuous_subtype_val _) _

open SKEFTHawking.SingularHomologyInt (Homology)
open SKEFTHawking.SingularFunctorialityInt

/-- Transport of homology along a homeomorphism of subspaces. -/
theorem homologyInt_bijective_of_homeo {Y Z : TopCat} (e : ↑Y ≃ₜ ↑Z) (n : ℕ) :
    Function.Bijective (Homology.mapInt (⟨e, e.continuous⟩ : C(↑Y, ↑Z)) n) :=
  SKEFTHawking.SingularSphereHomologyInt.Homology.mapInt_bijective_of_comp_id_all
    (⟨e, e.continuous⟩ : C(↑Y, ↑Z)) (⟨e.symm, e.symm.continuous⟩ : C(↑Z, ↑Y))
    (ContinuousMap.ext fun y => by exact e.symm_apply_apply y)
    (ContinuousMap.ext fun z => by exact e.apply_symm_apply z) n

theorem homologyInt_eq_zero_of_homeo {Y Z : TopCat} (e : ↑Y ≃ₜ ↑Z) (n : ℕ)
    (h : ∀ z : Homology Z n, z = 0) (y : Homology Y n) : y = 0 := by
  refine (homologyInt_bijective_of_homeo e n).1 ?_
  rw [map_zero]
  exact h _

theorem homologyInt_cyclic_of_homeo {Y Z : TopCat} (e : ↑Y ≃ₜ ↑Z) (n : ℕ)
    (h : ∃ a : Homology Z n, ∀ z : Homology Z n, ∃ k : ℤ, z = k • a) :
    ∃ a : Homology Y n, ∀ y : Homology Y n, ∃ k : ℤ, y = k • a := by
  obtain ⟨a, hgen⟩ := h
  obtain ⟨b, hb⟩ := (homologyInt_bijective_of_homeo e n).2 a
  refine ⟨b, fun y => ?_⟩
  obtain ⟨k, hk⟩ := hgen (Homology.mapInt (⟨e, e.continuous⟩ : C(↑Y, ↑Z)) n y)
  refine ⟨k, (homologyInt_bijective_of_homeo e n).1 ?_⟩
  rw [hk, map_zsmul, hb]

/-! ## §5. The chart-1 pair from an acyclic chart and a cyclic collar -/

open SKEFTHawking.SingularRelHomologyInt (connectingInt)

/-- **A pair group over an acyclic ambient is its subspace's `H₁`.** Pure pair-LES: with
`H₂(X;ℤ) = H₁(X;ℤ) = 0` the connecting map `δ : H₂(X, S; ℤ) → H₁(S;ℤ)` is bijective, so cyclicity
transports. -/
theorem relHomologyInt_cyclic_of_acyclic_ambient {X : TopCat} (S : Set ↑X)
    (h2 : ∀ x : Homology X 2, x = 0) (h1 : ∀ x : Homology X 1, x = 0)
    (hcyc : ∃ a : Homology (SKEFTHawking.SingularRelativeHomologyMod2.sub S) 1,
      ∀ x : Homology (SKEFTHawking.SingularRelativeHomologyMod2.sub S) 1, ∃ k : ℤ, x = k • a) :
    ∃ g : RelHomologyInt S 2, ∀ y : RelHomologyInt S 2, ∃ k : ℤ, y = k • g := by
  obtain ⟨a, hgen⟩ := hcyc
  have hbij := SKEFTHawking.SingularLocalHomologyInt.connectingInt_bijective_of_acyclic
    (X := X) S 1 h2 h1
  obtain ⟨g, hg⟩ := hbij.2 a
  refine ⟨g, fun y => ?_⟩
  obtain ⟨k, hk⟩ := hgen (connectingInt S 1 y)
  refine ⟨k, hbij.1 ?_⟩
  rw [hk, map_zsmul, hg]

/-! ## §6. The `H₂(K3;ℤ) ≅ ℤ²²` headline on three chart-1 homotopy facts -/

/-- The chart-1 piece actually retained by the two-threshold excision. Equal to
`chartNbhd1 r ∪ (outerE ∩ chartNbhd1 r')`: the chart-1 neighbourhood at the *first* threshold,
fattened by the part of the collar that reaches down to the *second*. -/
abbrev chart1Piece (r r' : ℝ) : Set ↑ResEtop := chartNbhd1 r' ∩ splitBOpen r

/-- The collar part of the retained piece. `outerE ⊆ splitBOpen r`, so it is just
`outerE ∩ chartNbhd1 r'`. -/
abbrev chart1Collar (r' : ℝ) : Set ↑ResEtop := outerE ∩ chartNbhd1 r'

/-- **Non-degeneracy of the retained piece**: `chart1Piece r r' ≠ univ`. The zero-section point over
the chart-0 origin is deep in chart `0` at *both* thresholds, so it is excised. Without this the
three hypotheses below could be satisfied by the ambient space itself, where they say nothing. -/
theorem chart1Piece_ne_univ {r r' : ℝ} (hr' : 0 ≤ r') :
    chart1Piece r r' ≠ (Set.univ : Set ↑ResEtop) := by
  intro h
  have hmem : chart0 (⟨0, by simp⟩, ⟨0, by simp⟩) ∈ chart1Piece r r' := by rw [h]; trivial
  refine hmem.1 ⟨(⟨0, by simp⟩, ⟨0, by simp⟩), ?_, rfl⟩
  show ‖((0 : ℂ))‖ ≤ r'
  simpa using hr'

theorem chart1Collar_inter (r r' : ℝ) :
    (outerE ∩ chartNbhd1 r') ∩ splitBOpen r = chart1Collar r' :=
  Set.inter_eq_self_of_subset_left
    (fun _ hy => SKEFTHawking.KummerChartNbhdInt.outerE_subset_splitBOpen r hy.1)

/-- **The headline, on THREE ordinary homotopy facts about explicit subsets of `E`.**

`H₂(K3;ℤ) ≅ ℤ²²` follows from:

* `H₂(chartNbhd1 r' ∩ splitBOpen r; ℤ) = 0` and `H₁(… ; ℤ) = 0` — the retained chart-1 piece is
  acyclic (it deformation-retracts onto the contractible `chartNbhd1 r ≅ D² × D²`), and
* `H₁(outerE ∩ chartNbhd1 r'; ℤ)` cyclic — the collar over chart 1 is `D² × annulus ≃ S¹`.

Nothing in these mentions the zero section, an orientation, a sign, or the Euler number: the
extension problem was already dissolved by `KummerCollarPairLESInt.cyclic_iff_gen_mem_two_smul`. -/
theorem kummerK3_b2_target_of_chart1_geometry {r r' : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    (hr'1 : r' < 1) (hr' : r' < r)
    (h2 : ∀ x : Homology
      (SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Piece r r')) 2, x = 0)
    (h1 : ∀ x : Homology
      (SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Piece r r')) 1, x = 0)
    (hcyc : ∃ a : Homology
        (SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Collar r')) 1,
      ∀ x : Homology (SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Collar r')) 1,
        ∃ k : ℤ, x = k • a) :
    SKEFTHawking.KummerK7Opener.kummerK3_b2_target := by
  -- the retained chart-1 piece, flattened out of the nested subtype
  have hflat2 : ∀ x : Homology
      (SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Sub r r')) 2, x = 0 :=
    fun x => homologyInt_eq_zero_of_homeo
      (Y := SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Sub r r'))
      (Z := SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Piece r r'))
      (subRestrHomeo (chartNbhd1 r') (splitBOpen r)) 2 h2 x
  have hflat1 : ∀ x : Homology
      (SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Sub r r')) 1, x = 0 :=
    fun x => homologyInt_eq_zero_of_homeo
      (Y := SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Sub r r'))
      (Z := SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Piece r r'))
      (subRestrHomeo (chartNbhd1 r') (splitBOpen r)) 1 h1 x
  -- the collar, flattened through the two nestings
  have hcollar : ∃ a : Homology (SKEFTHawking.SingularRelativeHomologyMod2.sub
        (restr (outerSub r) (chart1Sub r r'))) 1,
      ∀ x : Homology (SKEFTHawking.SingularRelativeHomologyMod2.sub
        (restr (outerSub r) (chart1Sub r r'))) 1, ∃ k : ℤ, x = k • a := by
    refine homologyInt_cyclic_of_homeo
      (Y := SKEFTHawking.SingularRelativeHomologyMod2.sub
        (restr (outerSub r) (chart1Sub r r')))
      (Z := SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Collar r'))
      ?_ 1 hcyc
    refine (subRestrHomeo (outerSub r) (chart1Sub r r')).trans ?_
    refine (Homeomorph.setCongr (?_ : outerSub r ∩ chart1Sub r r'
      = restr (outerE ∩ chartNbhd1 r') (splitBOpen r))).trans ?_
    · exact (Set.preimage_inter).symm
    · exact (subRestrHomeo (outerE ∩ chartNbhd1 r') (splitBOpen r)).trans
        (Homeomorph.setCongr (chart1Collar_inter r r'))
  exact kummerK3_b2_target_of_chart1_local hr0 hr1 hr'1 hr'
    (relHomologyInt_cyclic_of_acyclic_ambient (X :=
      SKEFTHawking.SingularRelativeHomologyMod2.sub (chart1Sub r r'))
      (restr (outerSub r) (chart1Sub r r')) hflat2 hflat1 hcollar)

end

end SKEFTHawking.KummerSplitBChart1ExcisionInt
